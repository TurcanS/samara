+/* Copy the elected sync master's channel sequence (with its encoding), so we
+ * are on-channel in its availability windows and advertise a sequence it
+ * accepts. Back to the static sequence when we are our own master again. */
+static void awdl_follow_master_chanseq(struct awdl_state *awdl) {
+	struct awdl_peer *master;
+
+	if (awdl->channel.follow_disabled)
+		return;
+	if (awdl_election_is_sync_master(&awdl->election, &awdl->self_address)) {
+		if (awdl->channel.follows_master) {
+			awdl_chanseq_init_static(awdl->channel.sequence, &awdl->channel.master);
+			awdl->channel.enc = AWDL_CHAN_ENC_OPCLASS;
+			awdl->channel.follows_master = 0;
+			awdl->channel.no_overlap = 0;
+			log_info("no sync master, back to static channel sequence");
+		}
+		return;
+	}
+	if (awdl_peer_get(awdl->peers.peers, &awdl->election.sync_addr, &master) < 0 || !master->has_sequence)
+		return;
+
+	struct awdl_chan seq[AWDL_CHANSEQ_LENGTH];
+	int kept = AWDL_CHANSEQ_LENGTH;
+	if (awdl->channel.intersect) {
+		/* -I: the radio sits on our channel whatever the sequence says (a
+		 * P2P-GO chanctx pins it), so advertise only the master's slots there.
+		 * Claiming its other slots made the iPhone address us where we were
+		 * not (measured 2026-11-03: synced, never connected). */
+		uint8_t ours = awdl_chan_num(awdl->channel.master, AWDL_CHAN_ENC_OPCLASS);
+		kept = awdl_chanseq_intersect(seq, master->sequence, master->sequence_enc, ours);
+		if (!kept) {
+			/* Keep what we advertised last rather than an all-empty sequence,
+			 * which reads as "never available". Logged once per episode. */
+			if (!awdl->channel.no_overlap)
+				log_info("NO OVERLAP with %s on ch %d - peer wants ch %d",
+				         ether_ntoa(&master->addr), ours,
+				         awdl_chanseq_dominant_chan(master->sequence, master->sequence_enc));
+			awdl->channel.no_overlap = 1;
+			return;
+		}
+		awdl->channel.no_overlap = 0;
+	} else {
+		memcpy(seq, master->sequence, sizeof(seq));
+	}
+	if (awdl->channel.enc != master->sequence_enc ||
+	    memcmp(awdl->channel.sequence, seq, sizeof(seq))) {
+		awdl->channel.enc = master->sequence_enc;
+		memcpy(awdl->channel.sequence, seq, sizeof(seq));
+		awdl->channel.follows_master = 1;
+		if (awdl->channel.intersect)
+			log_info("following sync master %s: %d/%d slots on our channel", ether_ntoa(&master->addr),
+			         kept, AWDL_CHANSEQ_LENGTH);
+		else
+			log_info("following channel sequence of sync master %s", ether_ntoa(&master->addr));
+	}
 }
 
