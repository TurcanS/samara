+
+	if (!m)
+		return -ENOMEM;
+	ht[0] = ht_cap & 0xff;
+	ht[1] = ht_cap >> 8;
+	ht[2] = ht_ampdu;
+	memcpy(ht + 3, ht_mcs, 4);
+
+	genlmsg_put(m, 0, 0, nl80211_state.nl80211_id, 0, 0, NL80211_CMD_NEW_STATION, 0);
+	NLA_PUT_U32(m, NL80211_ATTR_IFINDEX, ifindex);
+	NLA_PUT(m, NL80211_ATTR_MAC, ETH_ALEN, addr);
+	NLA_PUT(m, NL80211_ATTR_STA_SUPPORTED_RATES, sizeof(rates), rates);
+	NLA_PUT_U16(m, NL80211_ATTR_STA_AID, aid);
+	NLA_PUT_U16(m, NL80211_ATTR_STA_LISTEN_INTERVAL, 1);
+	NLA_PUT(m, NL80211_ATTR_STA_FLAGS2, sizeof(flags), &flags);
+	NLA_PUT(m, NL80211_ATTR_HT_CAPABILITY, sizeof(ht), ht);
+	if (vht_cap)
