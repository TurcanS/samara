+static int nl80211_ack_done(struct nl_msg *msg __attribute__((unused)), void *arg) {
+	*(int *) arg = 0;
+	return NL_STOP;
+}
+
+/* Send a request and return the kernel's answer to it (0 or -errno). */
+static int nl80211_request(struct nl_msg *m) {
+	int result = 1;
+	struct nl_cb *cb = nl_cb_alloc(NL_CB_DEFAULT);
+	int err;
+
+	if (!cb)
+		return -ENOMEM;
+	nl_cb_err(cb, NL_CB_CUSTOM, nl80211_ack_error, &result);
+	nl_cb_set(cb, NL_CB_ACK, NL_CB_CUSTOM, nl80211_ack_done, &result);
+	err = nl_send_auto(nl80211_state.socket, m);
+	while (err >= 0 && result > 0)
+		err = nl_recvmsgs(nl80211_state.socket, cb);
+	nl_cb_put(cb);
+	if (result <= 0) /* the kernel answered: 0 or its -errno */
+		return result;
+	return -EIO;
+}
