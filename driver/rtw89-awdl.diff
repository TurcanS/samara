 static void rtw89_core_rx_to_mac80211(struct rtw89_dev *rtwdev,
 				      struct rtw89_rx_phy_ppdu *phy_ppdu,
 				      struct rtw89_rx_desc_info *desc_info,
@@ -4018,6 +4139,9 @@ static void rtw89_core_rx_to_mac80211(struct rtw89_dev *rtwdev,
 	if (unlikely(!napi_is_scheduled(napi)))
 		napi = NULL;
 
+	if (unlikely(READ_ONCE(rtw89_awdl_ba)))
+		rtw89_awdl_ba_rx(rtwdev, skb_ppdu);
+
 	rtw89_core_hw_to_sband_rate(rx_status);
 	rtw89_core_rx_stats(rtwdev, phy_ppdu, desc_info, skb_ppdu);
 	rtw89_core_update_rx_status_by_ppdu(rtwdev, rx_status, phy_ppdu);
@@ -4716,6 +4840,17 @@ static void rtw89_core_txq_check_agg(struct rtw89_dev *rtwdev,
 	if (test_bit(RTW89_TXQ_F_FORBID_BA, &rtwtxq->flags))
 		return;
 
+	/* awdl_ba: frames injected to an AWDL peer never start mac80211's own session (the peer
+	 * does not answer it, and the queue stops for a second each time); they are aggregated
+	 * once the peer accepted OWL's request (rtw89_awdl_ba_work).
+	 */
+	if (READ_ONCE(rtw89_awdl_ba) &&
+	    (IEEE80211_SKB_CB(skb)->flags & IEEE80211_TX_CTL_INJECTED)) {
+		if (test_bit(RTW89_TXQ_F_AMPDU, &rtwtxq->flags))
+			IEEE80211_SKB_CB(skb)->flags |= IEEE80211_TX_CTL_AMPDU;
+		return;
+	}
+
 	if (unlikely(skb->protocol == cpu_to_be16(ETH_P_PAE))) {
 		rtw89_core_stop_tx_ba_session(rtwdev, rtwtxq);
 		return;
@@ -6742,6 +6877,7 @@ void rtw89_core_stop(struct rtw89_dev *rtwdev)
 
 	wiphy_work_cancel(wiphy, &rtwdev->c2h_work);
 	wiphy_work_cancel(wiphy, &rtwdev->cancel_6ghz_probe_work);
+	wiphy_work_cancel(wiphy, &rtwdev->awdl_ba.work);
 	wiphy_work_cancel(wiphy, &btc->eapol_notify_work);
 	wiphy_work_cancel(wiphy, &btc->arp_notify_work);
 	wiphy_work_cancel(wiphy, &btc->dhcp_notify_work);
@@ -6998,6 +7134,8 @@ int rtw89_core_init(struct rtw89_dev *rtwdev)
 	if (!rtwdev->txq_wq)
 		return -ENOMEM;
 	spin_lock_init(&rtwdev->ba_lock);
+	spin_lock_init(&rtwdev->awdl_ba.lock);
+	wiphy_work_init(&rtwdev->awdl_ba.work, rtw89_awdl_ba_work);
 	spin_lock_init(&rtwdev->rpwm_lock);
 	rtwdev->total_sta_assoc = 0;
 
