+int station_add(int ifindex, const struct ether_addr *addr, uint16_t aid, uint16_t ht_cap, uint8_t ht_ampdu,
+                const uint8_t ht_mcs[4], const uint8_t *vht_cap) {
+	/* 6 to 54 Mbit/s in 500 kbit/s units: the 5 GHz OFDM rates every HT device has */
+	static const uint8_t rates[] = {12, 18, 24, 36, 48, 72, 96, 108};
+	struct nl80211_sta_flag_update flags = {
+		.mask = (1 << NL80211_STA_FLAG_AUTHORIZED) | (1 << NL80211_STA_FLAG_WME),
+		.set = (1 << NL80211_STA_FLAG_AUTHORIZED) | (1 << NL80211_STA_FLAG_WME),
+	};
+	uint8_t ht[26] = {0}; /* struct ieee80211_ht_cap: info, A-MPDU parameters, MCS set (16), rest zero */
+	struct nl_msg *m = nlmsg_alloc();
