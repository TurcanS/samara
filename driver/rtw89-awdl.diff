+/* AirDrop/AWDL (module parameter awdl_ba): Block Ack answers from AWDL peers, seen on RX and
+ * applied in a wiphy work item. user space (OWL) negotiates the session in AWDL's frame format,
+ * which mac80211 neither sends nor accepts; the driver only watches for the peer's answer.
+ */
+#define RTW89_AWDL_BA_SLOTS 8
+
+struct rtw89_awdl_ba_req {
+	u8 peer[ETH_ALEN];
+	u8 own[ETH_ALEN];
+	u8 tid;
+	u8 buf_size;
+	bool enable;
+};
+
+struct rtw89_awdl_ba {
+	spinlock_t lock; /* protects req and n */
+	struct wiphy_work work;
+	struct rtw89_awdl_ba_req req[RTW89_AWDL_BA_SLOTS];
+	u8 n;
+};
+
