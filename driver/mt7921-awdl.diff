+		if (mcs >= 0 && mcs <= 15) {
+			injected_rate = FIELD_PREP(MT_TX_RATE_MODE, MT_PHY_TYPE_HT) |
+					FIELD_PREP(MT_TX_RATE_IDX, mcs) |
+					FIELD_PREP(MT_TX_RATE_NSS, mcs >> 3);
+			injected_bw = !!(info->control.rates[0].flags &
+					 IEEE80211_TX_RC_40_MHZ_WIDTH);
+			injected_sgi = !!(info->control.rates[0].flags &
+					  IEEE80211_TX_RC_SHORT_GI);
+			injected_legacy = true;
+			injected_ht = true;
+		}
+	}
+
 	pid = mt76_tx_status_skb_add(mdev, wcid, tx_info->skb);
+	/* Let the common builder apply all fixed-rate descriptor settings. */
+	if (injected_legacy)
+		info->flags |= IEEE80211_TX_CTL_USE_MINRATE;
 	mt76_connac2_mac_write_txwi(mdev, txwi_ptr, tx_info->skb, wcid, key,
 				    pid, qid, 0);
 
+	if (injected_legacy) {
+		__le32 *txd = txwi_ptr;
