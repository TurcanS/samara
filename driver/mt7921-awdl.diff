@@ -31,6 +238,26 @@ int mt7921e_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 	if (id < 0)
 		return id;
 
+	if (unlikely(mt7921e_awdl_ba) && sta &&
+	    !(info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP)) {
+		struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)tx_info->skb->data;
+
+		/* Injected QoS data without a rate: the firmware's own rate control and
+		 * aggregation carry it. mac80211 asks for a TX status report on every
