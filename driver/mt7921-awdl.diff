 #include "../dma.h"
 #include "../mt76_connac2_mac.h"
 
+/* Samara (E-TXAGG, second build): aggregate what user space injects to an AWDL peer
+ * that it registered as a station of our access-point interface.
+ *
+ * The Block Ack session is negotiated by user space (OWL), in AWDL's own frame format, which
+ * mac80211 neither sends nor accepts. This driver only watches for the peer's answer: an
+ * ADDBA response with status 0 from a station switches the firmware's originator Block Ack
+ * for that station and TID on, a DELBA from the recipient switches it off. Injected QoS data
+ * without a rate then goes out with the firmware's rate control and aggregation, numbered by
+ * user space. mac80211's own session start is kept away from these stations.
+ * Off by default; /sys/module/mt7921e/parameters/awdl_ba switches it per session.
+ */
+static bool mt7921e_awdl_ba;
+module_param_named(awdl_ba, mt7921e_awdl_ba, bool, 0644);
+MODULE_PARM_DESC(awdl_ba, "Block Ack towards AWDL peers registered as stations (Samara)");
+
+/* Width of those frames: 0 leaves it to the firmware (it stayed at 20 MHz on 2026-11-16 with
+ * an 80 MHz access point and a VHT80 station), 1 = 40 MHz, 2 = 80 MHz, never wider than the
+ * station's own width. Only the width is fixed; the rate stays the firmware's.
+ */
+static unsigned int mt7921e_awdl_bw;
+module_param_named(awdl_bw, mt7921e_awdl_bw, uint, 0644);
+MODULE_PARM_DESC(awdl_bw, "Width of aggregated frames to AWDL stations: 0 firmware, 1 = 40 MHz, 2 = 80 MHz");
+
+static const u8 mt7921e_awdl_bssid[ETH_ALEN] = { 0x00, 0x25, 0x00, 0xff, 0x94, 0x73 };
+
+#define MT7921E_AWDL_BA_SLOTS	8
+
+struct mt7921e_awdl_ba_req {
+	bool used;
+	bool enable;
+	u16 wcid;
+	u8 tid;
+	u16 buf_size;
+};
+
+static DEFINE_SPINLOCK(mt7921e_awdl_ba_lock);
+static struct mt7921e_awdl_ba_req mt7921e_awdl_ba_reqs[MT7921E_AWDL_BA_SLOTS];
+static struct mt792x_dev *mt7921e_awdl_ba_dev;
+
+static void mt7921e_awdl_ba_work_fn(struct work_struct *work)
+{
+	struct mt7921e_awdl_ba_req reqs[MT7921E_AWDL_BA_SLOTS];
+	struct mt792x_dev *dev;
+	struct ieee80211_hw *hw;
+	int i;
+
+	spin_lock_bh(&mt7921e_awdl_ba_lock);
+	memcpy(reqs, mt7921e_awdl_ba_reqs, sizeof(reqs));
+	memset(mt7921e_awdl_ba_reqs, 0, sizeof(mt7921e_awdl_ba_reqs));
+	dev = mt7921e_awdl_ba_dev;
+	spin_unlock_bh(&mt7921e_awdl_ba_lock);
+	if (!dev)
+		return;
+
+	hw = mt76_hw(dev);
+	/* stations are added and removed under the wiphy lock: the entry stays while we hold it */
+	wiphy_lock(hw->wiphy);
+	for (i = 0; i < MT7921E_AWDL_BA_SLOTS; i++) {
+		struct ieee80211_ampdu_params params = {};
+		struct ieee80211_sta *sta;
+		struct mt792x_sta *msta;
+		struct mt76_wcid *wcid;
+		int ret;
+
+		if (!reqs[i].used)
+			continue;
+
+		rcu_read_lock();
+		wcid = rcu_dereference(dev->mt76.wcid[reqs[i].wcid]);
+		sta = wcid_to_sta(wcid);
+		rcu_read_unlock();
+		if (!sta || !sta->txq[reqs[i].tid])
+			continue;
+
+		msta = (struct mt792x_sta *)sta->drv_priv;
+		params.sta = sta;
+		params.tid = reqs[i].tid;
+		params.buf_size = reqs[i].buf_size;
+		params.amsdu = false;
+
+		mt792x_mutex_acquire(dev);
+		msta->deflink.wcid.amsdu = false;
+		ret = mt76_connac_mcu_sta_ba(&dev->mt76, &msta->vif->bss_conf.mt76, &params,
+					     MCU_UNI_CMD(STA_REC_UPDATE), reqs[i].enable, true);
+		mt792x_mutex_release(dev);
+
+		dev_info(dev->mt76.dev, "awdl_ba: %pM tid %u: aggregation %s (window %u)%s\n",
+			 sta->addr, reqs[i].tid, reqs[i].enable ? "on" : "off", reqs[i].buf_size,
+			 ret ? ", firmware refused" : "");
+	}
+	wiphy_unlock(hw->wiphy);
+}
+
+static DECLARE_WORK(mt7921e_awdl_ba_work, mt7921e_awdl_ba_work_fn);
+
+void mt7921e_awdl_ba_cancel(struct mt792x_dev *dev)
+{
+	spin_lock_bh(&mt7921e_awdl_ba_lock);
+	if (mt7921e_awdl_ba_dev == dev)
+		mt7921e_awdl_ba_dev = NULL;
+	memset(mt7921e_awdl_ba_reqs, 0, sizeof(mt7921e_awdl_ba_reqs));
+	spin_unlock_bh(&mt7921e_awdl_ba_lock);
+	cancel_work_sync(&mt7921e_awdl_ba_work);
+}
+
+static void mt7921e_awdl_ba_queue(struct mt792x_dev *dev, u16 wcid, u8 tid, u16 buf_size, bool enable)
+{
+	int i, slot = -1;
+
+	spin_lock_bh(&mt7921e_awdl_ba_lock);
+	for (i = 0; i < MT7921E_AWDL_BA_SLOTS; i++) {
+		struct mt7921e_awdl_ba_req *r = &mt7921e_awdl_ba_reqs[i];
+
+		if (r->used && r->wcid == wcid && r->tid == tid) {
+			slot = i; /* the newer answer wins */
+			break;
+		}
+		if (!r->used && slot < 0)
+			slot = i;
+	}
+	if (slot >= 0) {
+		mt7921e_awdl_ba_reqs[slot] = (struct mt7921e_awdl_ba_req){
+			.used = true, .enable = enable, .wcid = wcid, .tid = tid, .buf_size = buf_size,
+		};
+		mt7921e_awdl_ba_dev = dev;
+	}
+	spin_unlock_bh(&mt7921e_awdl_ba_lock);
+	if (slot >= 0)
+		schedule_work(&mt7921e_awdl_ba_work);
+}
+
+void mt7921e_queue_rx_skb(struct mt76_dev *mdev, enum mt76_rxq_id q,
+			  struct sk_buff *skb, u32 *info)
+{
+	struct mt792x_dev *dev = container_of(mdev, struct mt792x_dev, mt76);
+	struct mt76_rx_status *status;
+	struct ieee80211_hdr *hdr;
+	struct sk_buff *tail;
+	struct mt76_wcid *wcid;
+	const u8 *body;
+	int room;
+
+	mt7921_queue_rx_skb(mdev, q, skb, info);
+	if (likely(!mt7921e_awdl_ba))
+		return;
+
+	/* A received frame is now the last one waiting for mt76_rx_poll_complete();
+	 * anything else was consumed or freed and must not be touched. Read only.
+	 */
+	tail = skb_peek_tail(&mdev->rx_skb[q]);
+	if (!tail || tail != skb)
+		return;
+
+	status = (struct mt76_rx_status *)tail->cb;
+	if (status->flag & RX_FLAG_8023)
+		return;
+
+	hdr = mt76_skb_get_hdr(tail);
+	room = tail->len - ((u8 *)hdr - tail->data);
+	if (room < 24 + 6 || !ieee80211_is_action(hdr->frame_control) ||
+	    ieee80211_has_protected(hdr->frame_control) ||
+	    is_multicast_ether_addr(hdr->addr1) ||
+	    !ether_addr_equal(hdr->addr3, mt7921e_awdl_bssid))
+		return;
+
+	body = (const u8 *)hdr + 24;
+	if (body[0] != WLAN_CATEGORY_BACK)
+		return;
+
+	wcid = status->wcid;
+	if (!wcid || !wcid->sta) {
+		/* the hardware did not match the sender to its table entry: look it up */
+		struct ieee80211_sta *sta;
+
+		sta = ieee80211_find_sta_by_ifaddr(mt76_hw(dev), hdr->addr2, hdr->addr1);
+		if (!sta)
+			return;
+		wcid = (struct mt76_wcid *)sta->drv_priv;
+	}
+
+	if (body[1] == WLAN_ACTION_ADDBA_RESP && room >= 24 + 9) {
+		/* token, status (2), parameters (2), timeout (2) */
+		u16 st = get_unaligned_le16(body + 3);
+		u16 capab = get_unaligned_le16(body + 5);
+		u8 tid = (capab >> 2) & 0xf;
+		u16 buf_size = capab >> 6;
+
+		if (st == WLAN_STATUS_SUCCESS && tid < 8) {
+			if (!buf_size || buf_size > 64)
+				buf_size = 64;
+			mt7921e_awdl_ba_queue(dev, wcid->idx, tid, buf_size, true);
+		}
+	} else if (body[1] == WLAN_ACTION_DELBA) {
+		/* parameters (2): initiator bit 11, TID bits 12-15; reason (2) */
+		u16 params = get_unaligned_le16(body + 2);
+
+		if (!(params & BIT(11)) && (params >> 12) < 8)
+			mt7921e_awdl_ba_queue(dev, wcid->idx, params >> 12, 0, false);
+	}
+}
