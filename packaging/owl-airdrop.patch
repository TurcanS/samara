+/* -G: most stations the access-point interface holds at a time (the MT7921 has 20 table
+ * entries in all), and the highest association ID its driver takes. Peers beyond either get
+ * plain frames. */
+#define AWDL_STATIONS_MAX 8
+#define AWDL_STATION_AID_MAX 20
+
+/* Make `peer` a station of the access-point interface, once. Without its HT capabilities (no
+ * MIF heard yet) the attempt is put off; a refusal is remembered and the peer keeps getting
+ * plain frames at OWL's own rate. */
+static void awdl_station_register(struct io_state *io, struct awdl_peer *peer) {
+	int err;
+
+	if (!io->sta_ifindex || peer->is_sta || peer->sta_failed || !peer->has_ht)
+		return;
+	if (io->sta_count >= AWDL_STATIONS_MAX || io->sta_last_aid >= AWDL_STATION_AID_MAX) {
+		peer->sta_failed = 1;
+		return;
+	}
+	err = station_add(io->sta_ifindex, &peer->addr, (uint16_t) ++io->sta_last_aid, peer->ht_cap, peer->ht_ampdu,
+	                  peer->ht_mcs, peer->has_vht ? peer->vht_cap : NULL);
+	if (err < 0) {
+		peer->sta_failed = 1;
+		log_warn("station: could not register %s (%s); it gets single frames", ether_ntoa(&peer->addr),
+		         strerror(-err));
+		return;
+	}
+	io->sta_count++;
+	peer->is_sta = 1;
+	log_info("station: registered %s (HT caps 0x%04x, %d stream%s%s)",
+	         ether_ntoa(&peer->addr), peer->ht_cap, peer->ht_mcs[1] ? 2 : 1, peer->ht_mcs[1] ? "s" : "",
+	         peer->has_vht ? ", VHT" : "");
+}
+
+/* -G: ask a station peer for a Block Ack session (the driver switches the firmware's
+ * aggregation on when it sees the peer agree). Called when a frame is about to go to the peer,
+ * so the peer is on our channel. An iPhone only answers once a transfer is running (3 of 3
+ * requests sent before one went unanswered on 2026-11-16, each one sent during one was
+ * granted), so a request goes out only ahead of a full-size frame, every 2 s until granted.
+ * Data is held for the answer, 50 ms at most: the session starts at the next frame's number.
+ * Until the peer agrees it gets plain frames at OWL's own rate, as without -G.
+ * Returns the seconds to wait before sending data, 0 to send now. */
+#define AWDL_BA_TRIES 60
+#define AWDL_BA_RETRY_US 2000000
+#define AWDL_BA_WAIT_US 50000
+#define AWDL_BA_BULK_LEN 1000
+static double awdl_station_block_ack(struct daemon_state *state, struct awdl_peer *peer, uint64_t now) {
+	if (!peer->is_sta || peer->ba_granted || state->io.sta_no_ba)
+		return 0;
+	if (peer->ba_wait_until > now)
+		return usec_to_sec(peer->ba_wait_until - now);
+	if (peer->ba_wait_until) { /* the wait ran out without an answer */
+		peer->ba_wait_until = 0;
+		log_info("Block Ack: no answer from %s to request %d", ether_ntoa(&peer->addr), 0x40 + peer->ba_tries - 1);
+	}
+	if (buf_len(state->next) >= AWDL_BA_BULK_LEN && peer->ba_tries < AWDL_BA_TRIES &&
+	    (!peer->ba_last || now - peer->ba_last > AWDL_BA_RETRY_US)) {
+		uint8_t req[128];
+		uint8_t token = (uint8_t) (0x40 + peer->ba_tries);
+		int len = ieee80211_init_addba_request(req, &state->awdl_state, &state->ieee80211_state, &peer->addr,
+		                                       token, peer->qos_seq);
+		peer->ba_tries++;
+		peer->ba_last = now;
+		if (len > 0 && wlan_send(&state->io, req, len) >= 0) {
+			peer->ba_wait_until = now + AWDL_BA_WAIT_US;
+			log_info("Block Ack: asked %s (request %d, starting at %d)", ether_ntoa(&peer->addr), token,
+			         peer->qos_seq);
+			return usec_to_sec(AWDL_BA_WAIT_US);
+		}
+	}
+	return 0;
+}
