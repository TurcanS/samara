 int mt7921e_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 			   enum mt76_txq_id qid, struct mt76_wcid *wcid,
 			   struct ieee80211_sta *sta,
@@ -15,6 +216,12 @@ int mt7921e_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 	struct ieee80211_key_conf *key = info->control.hw_key;
 	struct mt76_connac_hw_txp *txp;
 	struct mt76_txwi_cache *t;
+	bool use_minrate = info->flags & IEEE80211_TX_CTL_USE_MINRATE;
+	bool injected_legacy = false;
+	bool injected_ht = false;
+	u8 awdl_bw = 0;
+	u8 injected_bw = 0, injected_sgi = 0;
+	u16 injected_rate = 0;
 	int id, pid;
