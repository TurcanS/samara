+/* One line every few seconds while traffic flows: what a trace needs to tell
+ * "nothing sent" from "sent but not acknowledged" without a packet capture. */
+void awdl_log_traffic(struct ev_loop *loop, ev_timer *timer, int revents) {
+	(void) loop;
+	(void) revents;
+	static struct awdl_stats last;
+	struct daemon_state *state = timer->data;
+	struct awdl_stats *s = &state->awdl_state.stats;
+
+	if (s->tx_data_unicast != last.tx_data_unicast || s->rx_data != last.rx_data ||
+	    s->rx_addba != last.rx_addba) {
+		log_info("traffic: tx unicast %llu (acked %llu, lost %llu, %llu sent on presence), rx data %llu, "
+		         "mcast dropped %llu, block-ack requests %llu",
+		         (unsigned long long) (s->tx_data_unicast - last.tx_data_unicast),
+		         (unsigned long long) (s->tx_status_ok - last.tx_status_ok),
+		         (unsigned long long) (s->tx_status_fail - last.tx_status_fail),
+		         (unsigned long long) (s->tx_presence - last.tx_presence),
+		         (unsigned long long) (s->rx_data - last.rx_data),
+		         (unsigned long long) (s->tx_data_multicast_dropped - last.tx_data_multicast_dropped),
+		         (unsigned long long) (s->rx_addba - last.rx_addba));
+		last = *s;
+	}
+}
